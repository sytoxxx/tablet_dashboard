# Coffee Morning — environment

# Optional: enable real vision analysis (otherwise mock AI is used)
OPENAI_API_KEY=
# Optional model override
OPENAI_PLAN_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Bus providers (Steiermark / Kapfenberg–Bruck–Apfelmoar first)
# BUS_PROVIDER: auto | verbund-steiermark | vao | wienerlinien | local | mock
# auto = Steiermark TRIAS if URL set → VAO if keyed → Wiener Linien if numeric RBL → local
# ---------------------------------------------------------------------------
BUS_PROVIDER=auto

# Verbund Linie / Verkehrsverbund Steiermark — TRIAS OGD (VDV-431)
# Apply: e-mail to ogdtrias@verbundlinie.at (agreement) → they send the endpoint URL.
# Docs/FAQ: Verbund Linie „FAQ zur OGD-Service-Schnittstelle TRIAS“
VERBUND_STEIERMARK_TRIAS_URL=
# Optional RequestorRef from the provider (default OpenService)
VERBUND_STEIERMARK_REQUESTOR_REF=

# VAO START — Austria-wide REST (departure board / routing)
# Apply: start@verkehrsauskunft.at — signed contract + personal access key
# They also provide the base URL for your key. Do not invent either value.
VAO_API_KEY=
VAO_BASE_URL=

# Wiener Linien OGD realtime — optional, Vienna RBL only, no key
# (used only when provider=wienerlinien or auto + numeric RBL and no Steiermark/VAO)

# Weather: open-meteo (default, no key) | mock
# Location comes from AppData region / person.weatherLocation (default Kapfenberg)
WEATHER_PROVIDER=open-meteo
