# Coffee Morning — environment

# Optional: enable real vision analysis (otherwise mock AI is used)
OPENAI_API_KEY=
# Optional model override
OPENAI_PLAN_MODEL=gpt-4o-mini

# Bus provider: auto | local | mock | wienerlinien
# auto = Wiener Linien when person has RBL (externalId), else local timetable
BUS_PROVIDER=auto

# Weather provider: open-meteo (default, no key) | mock
WEATHER_PROVIDER=open-meteo
